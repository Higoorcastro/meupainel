# Normaliza quebras de linha (o Git do Windows com core.autocrlf=true converteria tudo para CRLF).
* text=auto

# Scripts executados no Linux/VPS precisam de LF, senão falham com "bad interpreter" / "$'\r': command not found".
*.sh      text eol=lf
gradlew   text eol=lf
Dockerfile text eol=lf
*.yml     text eol=lf
Caddyfile text eol=lf
*.conf    text eol=lf

# Scripts do Windows
*.bat     text eol=crlf
*.ps1     text eol=crlf

# Binários
*.jar     binary
*.png     binary
*.jpg     binary
*.webp    binary
*.mp4     binary
*.apk     binary
