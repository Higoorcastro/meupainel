# Domínio apontado (registro DNS tipo A) para o IP da VPS. Usado pelo Caddy para o HTTPS.
DOMAIN=meupainel.gestorshop.com

# Endereço público do painel (com https://). Os links das mídias enviados às TVs usam esta URL.
PUBLIC_URL=https://meupainel.gestorshop.com

# Senha do painel web. Use uma senha forte!
ADMIN_PASSWORD=troque-esta-senha

# Segredo para assinar a sessão (opcional; se vazio, é gerado automaticamente em data/).
# Gere um com: openssl rand -hex 32
SESSION_SECRET=

# Tamanho máximo de cada arquivo enviado, em MB.
MAX_UPLOAD_MB=2048
